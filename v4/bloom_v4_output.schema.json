{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bloom_v4_output.schema.json",
  "title": "Bloom v4 LLM Coding Output",
  "description": "Strict output schema for Phase 1 Bloom negation coding, policy bloom_v4. Changes from bloom_v3: schema_version bumped; new required per-prediction key `certain` (Yes/No self-reported label confidence, mirroring the human coders' certain_bloom field), emitted after bloom_label so the label precedes the confidence judgment at decoding time; record_id pattern generalized from English-only to all language prefixes (eng, ger, heb, spa, tgm, tgn). Property order remains meaningful: comments precedes bloom_label so the stated reason precedes the label at constrained-decoding time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "predictions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "bloom_v4"
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "comments", "bloom_label", "certain", "flags"],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^(eng|ger|heb|spa|tgm|tgn)_[0-9]{6}$"
          },
          "comments": {
            "type": "string",
            "maxLength": 300
          },
          "bloom_label": {
            "type": "string",
            "enum": [
              "Nonexistence",
              "Rejection",
              "Denial",
              "Nonpossession",
              "Uncoded",
              "Excluded"
            ]
          },
          "certain": {
            "type": "string",
            "enum": ["Yes", "No"]
          },
          "flags": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "foreign_language_negation",
              "singing",
              "mimicry",
              "tag_question",
              "repetition",
              "not_a_negation"
            ],
            "properties": {
              "foreign_language_negation": {
                "type": "string",
                "enum": ["Yes", "No"]
              },
              "singing": {
                "type": "string",
                "enum": ["Yes", "No"]
              },
              "mimicry": {
                "type": "string",
                "enum": ["Yes", "No"]
              },
              "tag_question": {
                "type": "string",
                "enum": ["Yes", "No"]
              },
              "repetition": {
                "type": "string",
                "enum": ["Yes", "No"]
              },
              "not_a_negation": {
                "type": "string",
                "enum": ["Yes", "No"]
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bloom_v5_output.schema.json",
  "title": "Bloom v5 LLM Coding Output",
  "description": "Strict output schema for multilingual Bloom negation coding, policy bloom_v5. The output structure is unchanged from bloom_v4; only the schema version is bumped so v5 runs remain traceable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "predictions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "bloom_v5"
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "comments",
          "bloom_label",
          "certain",
          "flags"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^(eng|ger|heb|spa|tgm|tgn)_[0-9]{6}$"
          },
          "comments": {
            "type": "string",
            "maxLength": 300
          },
          "bloom_label": {
            "type": "string",
            "enum": [
              "Nonexistence",
              "Rejection",
              "Denial",
              "Nonpossession",
              "Uncoded",
              "Excluded"
            ]
          },
          "certain": {
            "type": "string",
            "enum": [
              "Yes",
              "No"
            ]
          },
          "flags": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "foreign_language_negation",
              "singing",
              "mimicry",
              "tag_question",
              "repetition",
              "not_a_negation"
            ],
            "properties": {
              "foreign_language_negation": {
                "type": "string",
                "enum": [
                  "Yes",
                  "No"
                ]
              },
              "singing": {
                "type": "string",
                "enum": [
                  "Yes",
                  "No"
                ]
              },
              "mimicry": {
                "type": "string",
                "enum": [
                  "Yes",
                  "No"
                ]
              },
              "tag_question": {
                "type": "string",
                "enum": [
                  "Yes",
                  "No"
                ]
              },
              "repetition": {
                "type": "string",
                "enum": [
                  "Yes",
                  "No"
                ]
              },
              "not_a_negation": {
                "type": "string",
                "enum": [
                  "Yes",
                  "No"
                ]
              }
            }
          }
        }
      }
    }
  }
}
